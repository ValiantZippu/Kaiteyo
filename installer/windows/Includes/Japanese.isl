; Kaiteyo — Japanese language file for Inno Setup.
; Mirrors the strings the app uses so the installer speaks the user's language.

[LangOptions]
LanguageName=日本語
LanguageID=$0411
LanguageCodePage=932
DialogFontName=Yu Gothic UI
DialogFontSize=9
WelcomeFontName=Yu Gothic UI
WelcomeFontSize=12
TitleFontName=Yu Gothic UI

[Messages]
SetupAppTitle=Kaiteyo インストーラー
SetupWindowTitle=Kaiteyo {#MyAppVersion} インストーラー

[CustomMessages]
LaunchApp=%1 を今すぐ起動
TaskGroupShortcuts=ショートカット
TaskDesktopIcon=デスクトップにショートカットを作成(&D)
TaskStartMenu=スタートメニューにフォルダを追加(&S)
TaskGroupIntegration=統合
TaskFileAssoc=.kaiteyo バックアップファイルを関連付け(&F)
TaskAutoUpdate=自動更新チェックを有効化(&A)
TaskGroupContent=コンテンツ
TaskDictionary=無料辞書スターターパックをインストール(&I)
UninstallProgram=%1 をアンインストール
