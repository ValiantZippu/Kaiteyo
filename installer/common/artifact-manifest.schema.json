{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ValiantZippu/Kaiteyo/blob/develop/installer/common/artifact-manifest.schema.json",
  "title": "Kaiteyo Release Artifact Manifest",
  "description": "Lists every binary attached to a GitHub release. Generated by scripts/stage-artifacts.sh, validated by CI, and used to assemble the update feed.",
  "type": "object",
  "required": ["schema_version", "version", "version_code", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "version_code": { "type": "integer" },
    "platform": { "enum": ["windows", "macos", "linux", "android"] },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "file", "sha256", "size_bytes", "arch"],
        "properties": {
          "key": {
            "enum": [
              "windows-exe", "windows-msi", "windows-portable",
              "macos-arm", "macos-intel",
              "linux-appimage", "linux-deb", "linux-rpm", "linux-flatpak",
              "android-apk"
            ]
          },
          "file": { "type": "string", "description": "File name, relative to the release directory" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "arch": { "enum": ["x64", "arm64", "aarch64", "universal", "amd64"] },
          "signed": { "type": "boolean", "description": "Whether the binary carries a code signature" }
        }
      }
    }
  }
}
